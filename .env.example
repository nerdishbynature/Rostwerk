# Copy to .env and adjust. Matches docker-compose.yml.
DATABASE_URL=postgres://rostwerk_app:rostwerk_app@localhost:54329/rostwerk
DATABASE_ADMIN_URL=postgres://rostwerk_admin:rostwerk_admin@localhost:54329/rostwerk
BIND=127.0.0.1:8080

# NATS JetStream for outbox events. Unset to log events instead.
NATS_URL=nats://localhost:4222

# Development only.
ROSTWERK_DEV_AUTH=1
ROSTWERK_ADMIN_TOKEN=dev-admin

# OIDC (Keycloak from docker-compose). Unset both to disable.
ROSTWERK_OIDC_ISSUER=http://localhost:8180/realms/rostwerk
ROSTWERK_OIDC_AUDIENCE=rostwerk-api
# Public client that /docs (Swagger UI) signs in with.
ROSTWERK_OIDC_DOCS_CLIENT_ID=rostwerk-docs

  "query": "UPDATE partners SET\n             name = coalesce($2, name),\n             kind = coalesce($3, kind),\n             email = CASE WHEN $4 THEN $5 ELSE email END,\n             ext = coalesce($6, ext),\n             updated_at = now()\n         WHERE id = $1\n         RETURNING id, name, kind AS \"kind: PartnerKind\", email, ext, created_at, updated_at",

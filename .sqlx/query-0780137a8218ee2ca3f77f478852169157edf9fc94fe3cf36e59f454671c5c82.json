  "query": "SELECT id, occurred_at, actor, entity_type, entity_id, action, before, after\n         FROM audit_log\n         WHERE ($1::text IS NULL OR entity_type = $1)\n           AND ($2::uuid IS NULL OR entity_id = $2)\n           AND ($3::bigint IS NULL OR id > $3)\n         ORDER BY id\n         LIMIT $4",

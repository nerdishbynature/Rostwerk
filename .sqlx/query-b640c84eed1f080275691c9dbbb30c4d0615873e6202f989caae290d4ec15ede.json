  "query": "SELECT t.id AS tenant_id, t.modules, m.kind AS \"kind: MemberKind\"\n         FROM tenant_members m JOIN tenants t ON t.id = m.tenant_id\n         WHERE m.subject = $1 AND ($2::uuid IS NULL OR m.tenant_id = $2)\n         ORDER BY t.id\n         LIMIT 2",
